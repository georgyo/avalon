{
  "name": "avalon-workspace",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "common",
    "client",
    "server"
  ],
  "bin": {
    "avalon-server": "./server/server.ts"
  },
  "scripts": {
    "build": "yarn workspace @avalon/client build",
    "bundle:server": "yarn workspace @avalon/server bundle",
    "start": "yarn workspace @avalon/server start",
    "lint": "eslint .",
    "test": "node tests/e2e-flow.mjs",
    "test:unit": "yarn workspace @avalon/common test && yarn workspace @avalon/client test:unit && yarn workspace @avalon/server test",
    "test:browser": "node tests/e2e-browser.mjs",
    "test:game": "node tests/e2e-full-game.mjs",
    "test:e2e": "node tests/e2e-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "resolutions": {
    "flatted": "^3.4.4"
  }
}
